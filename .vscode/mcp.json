{
  "servers": {
    "ado-readonly": {
      "type": "stdio",
      "command": "node",
      "cwd": "${workspaceFolder}",
      "args": [
        "scripts/start_ado_mcp.mjs"
      ]
    },
    "salesforce": {
      "type": "stdio",
      "command": "node",
      "cwd": "${workspaceFolder}",
      "args": [
        "scripts/start_salesforce_mcp.mjs",
        "--mode",
        "review",
        "--org-from-config"
      ]
    }
  }
}
